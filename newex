<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>Real Rates — RUB → USDT с графиком</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Chart.js для графиков -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, #0b3d3d 0%, #1a5c5c 50%, #0d3d3d 100%);
      color: #e2f0e8;
      padding: 20px;
      position: relative;
      overflow-x: hidden;
      overflow-y: auto;
    }

    body::before,
    body::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      opacity: 0.3;
      z-index: 0;
    }

    body::before {
      width: 400px;
      height: 400px;
      background: linear-gradient(135deg, #10b981, #06b6d4);
      top: -100px;
      left: -100px;
      animation: float1 8s ease-in-out infinite;
    }

    body::after {
      width: 300px;
      height: 300px;
      background: linear-gradient(135deg, #14b8a6, #2dd4bf);
      bottom: -50px;
      right: -50px;
      animation: float2 10s ease-in-out infinite;
    }

    @keyframes float1 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(50px, 50px); }
    }

    @keyframes float2 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-40px, -60px); }
    }

    .container {
      position: relative;
      z-index: 1;
      max-width: 520px;
      width: 100%;
      margin: 0 auto;
    }

    .header {
      text-align: center;
      margin-bottom: 32px;
      padding-top: 20px;
    }

    h1 {
      font-size: 2rem;
      font-weight: 800;
      background: linear-gradient(135deg, #fff 0%, #6ee7b7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 8px;
      letter-spacing: -0.03em;
      line-height: 1.1;
    }

    .subtitle {
      color: #99f6e4;
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      opacity: 0.9;
    }

    .card {
      background: rgba(15, 45, 45, 0.6);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(110, 231, 183, 0.2);
      border-radius: 24px;
      padding: 28px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(110, 231, 183, 0.1);
      margin-bottom: 20px;
    }

    .rate-box {
      background: rgba(10, 30, 30, 0.6);
      border: 1px solid rgba(110, 231, 183, 0.15);
      border-radius: 20px;
      padding: 32px 24px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .rate-box::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(110, 231, 183, 0.6), transparent);
    }

    .label {
      color: #99f6e4;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .rate {
      font-size: 2.5rem;
      font-weight: 800;
      background: linear-gradient(135deg, #fff 0%, #6ee7b7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin: 12px 0;
      letter-spacing: -0.02em;
      line-height: 1.3;
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .rate-value {
      font-size: 2.5rem;
      font-weight: 800;
      background: linear-gradient(135deg, #fff 0%, #6ee7b7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .rate-unit {
      font-size: 1rem;
      color: #6ee7b7;
      font-weight: 500;
      white-space: nowrap;
    }

    .rate-placeholder {
      font-size: 1.1rem;
      color: #5e9e8e;
      font-weight: 500;
    }

    .updated {
      color: #5e9e8e;
      font-size: 0.75rem;
      font-weight: 500;
      margin-top: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .updated::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10b981;
      animation: pulse 2s ease-in-out infinite;
    }

    .error-badge {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 12px;
      padding: 8px 12px;
      font-size: 0.75rem;
      color: #fca5a5;
      margin-top: 16px;
    }

    .chart-container {
      background: rgba(10, 30, 30, 0.6);
      border: 1px solid rgba(110, 231, 183, 0.15);
      border-radius: 20px;
      padding: 20px;
      margin-top: 20px;
    }

    .chart-title {
      color: #99f6e4;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 16px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      text-align: center;
    }

    canvas {
      max-height: 300px;
      width: 100%;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    @media (max-width: 480px) {
      h1 { font-size: 1.5rem; }
      .rate { font-size: 1.75rem; }
      .rate-value { font-size: 1.75rem; }
      .rate-unit { font-size: 0.85rem; }
      .card { padding: 22px; }
      .rate-box { padding: 24px 16px; }
      .header { padding-top: 10px; }
      .chart-container { padding: 15px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Real Rates</h1>
      <div class="subtitle">Москва • RUB → USDT</div>
    </div>

    <div class="card">
      <div class="rate-box">
        <div class="label" id="label">RUB → USDT (Москва)</div>
        <div class="rate" id="rate">
          <div class="rate-placeholder">Загрузка...</div>
        </div>
        <div class="updated" id="updated"></div>
        <div id="error" style="display: none;" class="error-badge"></div>
      </div>
    </div>

    <div class="chart-container">
      <div class="chart-title">📈 Динамика курса за последние 2 часа</div>
      <canvas id="rateChart"></canvas>
    </div>
  </div>

  <script>
    // Настройка наценки
    const MARKUP_RUB_USDT = 3.0;
    
    let rates = null;
    let chart = null;

    async function loadRates() {
      const rateEl = document.getElementById("rate");
      const errorEl = document.getElementById("error");
      
      try {
        const response = await fetch(`rate.json?t=${Date.now()}`, {
          cache: 'no-store',
          headers: { 'Cache-Control': 'no-cache' }
        });
        
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }
        
        rates = await response.json();
        errorEl.style.display = 'none';
        showRate();
      } catch (err) {
        console.error('Ошибка загрузки курса:', err);
        errorEl.textContent = '⚠️ Не удалось загрузить актуальный курс. Пожалуйста, обновите страницу.';
        errorEl.style.display = 'block';
        rateEl.innerHTML = '<div class="rate-placeholder">Ошибка загрузки</div>';
      }
    }

    function showRate() {
      if (!rates) return;
      
      const baseRate = rates.rub_usdt_msk;
      if (!baseRate) {
        document.getElementById("rate").innerHTML = '<div class="rate-placeholder">Нет данных</div>';
        return;
      }

      const displayRate = baseRate + MARKUP_RUB_USDT;
      document.getElementById("rate").innerHTML = `<span class="rate-value">${displayRate.toFixed(6)}</span><span class="rate-unit">RUB за 1 USDT</span>`;
      
      if (rates.updated_at) {
        const d = new Date(rates.updated_at);
        document.getElementById("updated").textContent = `Обновлено: ${d.toLocaleString("ru-RU")}`;
      }
    }

    async function loadHistory() {
      try {
        const response = await fetch(`history.json?t=${Date.now()}`, {
          cache: 'no-store',
          headers: { 'Cache-Control': 'no-cache' }
        });
        
        if (!response.ok) {
          console.warn('История не найдена');
          return;
        }
        
        const history = await response.json();
        const rubUsdtHistory = history.rub_usdt_history || [];
        
        if (rubUsdtHistory.length === 0) {
          console.warn('Нет данных для графика');
          return;
        }
        
        // Подготавливаем данные для графика
        const times = rubUsdtHistory.map(item => {
          const date = new Date(item.time);
          return date.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
        });
        
        const rates_ = rubUsdtHistory.map(item => item.rate);
        
        // Обновляем или создаём график
        if (chart) {
          chart.data.labels = times;
          chart.data.datasets[0].data = rates_;
          chart.update();
        } else {
          const ctx = document.getElementById('rateChart').getContext('2d');
          chart = new Chart(ctx, {
            type: 'line',
            data: {
              labels: times,
              datasets: [{
                label: 'Курс RUB за 1 USDT',
                data: rates_,
                borderColor: '#10b981',
                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                borderWidth: 2,
                pointRadius: 3,
                pointBackgroundColor: '#6ee7b7',
                pointBorderColor: '#0b3d3d',
                pointHoverRadius: 5,
                fill: true,
                tension: 0.3
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: true,
              plugins: {
                legend: {
                  labels: {
                    color: '#99f6e4',
                    font: { size: 12 }
                  }
                },
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      return `${context.parsed.y.toFixed(6)} RUB за 1 USDT`;
                    }
                  }
                }
              },
              scales: {
                y: {
                  grid: { color: 'rgba(110, 231, 183, 0.1)' },
                  ticks: { color: '#99f6e4' }
                },
                x: {
                  grid: { color: 'rgba(110, 231, 183, 0.1)' },
                  ticks: { color: '#99f6e4', rotation: 45, maxRotation: 45 }
                }
              }
            }
          });
        }
      } catch (err) {
        console.error('Ошибка загрузки истории:', err);
      }
    }

    // Загружаем курсы и историю
    loadRates();
    loadHistory();
    
    // Обновляем каждые 30 секунд
    setInterval(() => {
      loadRates();
      loadHistory();
    }, 30000);
  </script>
</body>
</html>
